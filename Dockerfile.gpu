# BioDex GPU Docker image (CUDA runtime + PyTorch GPU wheels)
FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md constraints.txt ./
COPY core ./core
COPY ui ./ui
COPY app.py ./

RUN pip3 install --no-cache-dir --upgrade pip \
    && pip3 install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu121 \
    && pip3 install --no-cache-dir -c constraints.txt ".[ui,models,video]"

EXPOSE 7860
ENV BIODEX_HOST=0.0.0.0 BIODEX_DEPLOY=1

CMD ["biodex-ui"]
